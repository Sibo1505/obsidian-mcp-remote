# Path to the vault checkout on the host (mounted into the container)
VAULT_PATH=/path/to/vault-checkout

# Tailscale IP of this host — the container port is bound only here, never to 0.0.0.0,
# so it stays unreachable from the public internet even if the public IP is misconfigured later
TAILSCALE_IP=100.x.x.x

# Host port to publish on TAILSCALE_IP — pick a free one, check with `sudo ss -tlnp` first
# (other services on a shared VPS may already occupy the obvious defaults, e.g. 3000)
HOST_PORT=3000

# Bearer token for internal/Tailscale access (Desktop-direct, Code) — min. 32 random bytes
TOKEN_INTERNAL=changeme-generate-with-openssl-rand-hex-32

# Public domain this server is reachable under (used for OAuth issuer/resource metadata)
DOMAIN=obsidian-mcp.example.com

# Port the server listens on inside the container
PORT=3000

# --- OAuth2 (M6) ---
# Password gate for the /oauth/authorize login form — min. 16 chars, generate with:
#   openssl rand -base64 24
OAUTH_PASSWORD=changeme-generate-with-openssl-rand-base64-24

# Preregistered OAuth client for the future Mobile/Web Custom Connector flow (claude.ai UI —
# Settings -> Connectors -> Add custom connector -> Advanced -> OAuth Client ID/Secret fields).
# Desktop-via-mcp-remote does NOT use this — it registers itself dynamically via POST /register.
OAUTH_CLIENT_ID=changeme-generate-with-openssl-rand-hex-16
OAUTH_CLIENT_SECRET=changeme-generate-with-openssl-rand-hex-32
# Exact redirect URI claude.ai's Custom Connector flow uses — not yet verified (M6 Mobile/Web
# testing pending), fill in once known from the actual claude.ai connector setup.
OAUTH_CLIENT_REDIRECT_URI=https://claude.ai/CHANGEME

# --- Optional hardening ---
# ntfy.sh topic for push notifications on rate-limit trips / failed logins. Leave empty to disable.
# Pick something unguessable (it's a public URL path, e.g. https://ntfy.sh/<topic>) — treat it like
# a secret, not a username. No account needed: https://ntfy.sh/<topic> to subscribe.
NTFY_TOPIC=
