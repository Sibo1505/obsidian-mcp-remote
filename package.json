{
  "name": "obsidian-mcp-remote",
  "version": "0.1.0",
  "description": "Remote MCP server for a self-hosted Obsidian vault (Gitea checkout on VPS)",
  "license": "MIT",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "npm run build:css && tsc",
    "build:css": "tailwindcss -i src/styles/theme.css -o public/theme.css --minify",
    "dev:css": "tailwindcss -i src/styles/theme.css -o public/theme.css --watch",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "setup": "node scripts/setup.mjs",
    "wizard": "node scripts/install-wizard.mjs",
    "verify": "node scripts/verify.mjs",
    "oauth:list": "node scripts/oauth-clients.mjs list",
    "oauth:revoke": "node scripts/oauth-clients.mjs revoke",
    "test": "tsx --test test/fs.test.ts test/middleware.test.ts test/oauth-model.test.ts test/oauth-flow.test.ts test/rate-limit.test.ts test/oauth-persistence.test.ts test/notify.test.ts test/webauthn.test.ts test/tools.test.ts test/discovery-and-security-headers.test.ts test/oauth-pruning.test.ts test/git.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@node-oauth/express-oauth-server": "^4.2.0",
    "@node-oauth/oauth2-server": "^5.3.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.1",
    "fast-glob": "^3.3.0",
    "gray-matter": "^4.0.3",
    "helmet": "^8.3.0",
    "json-logic-js": "^2.0.5",
    "minimatch": "^10.2.6",
    "safe-regex": "^2.1.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/express": "^4.17.0",
    "@types/json-logic-js": "^2.0.8",
    "@types/node": "^22.0.0",
    "@types/safe-regex": "^1.1.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
