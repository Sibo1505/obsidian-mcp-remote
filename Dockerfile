# Node 24 LTS on Debian 13 (trixie), pinned to an exact version and its multi-arch index digest so a
# rebuild gets the same base image instead of whatever the tag points to on that day. Bump both
# stages together.
FROM node:26.13.1-trixie-slim@sha256:e6bedef217677b276c591795e169840edd9096dbf13f29df8ef8d1856b8820bc AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install
COPY tsconfig.json ./
COPY src ./src
# public/ goes in before the build: build:css writes public/theme.css next to the static JS there,
# and Tailwind also scans those files for the class names they toggle.
COPY public ./public
RUN npm run build

FROM node:26.13.1-trixie-slim@sha256:e6bedef217677b276c591795e169840edd9096dbf13f29df8ef8d1856b8820bc
WORKDIR /app
ENV NODE_ENV=production
# vault/git.ts shells out to the git CLI at runtime (commit+push after writes, JIT pull before
# reads) — the slim base image doesn't include it, unlike the build stage's toolchain.
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*
# uid/gid 999 pinned rather than left to useradd: the vault checkout gets chowned to 999 (see
# docs/*/installation.md) and everything in /data was written as 999, so a base image that hands out
# a different system uid would make writes fail with EACCES. Pinned, a taken id fails the build.
RUN groupadd --system --gid 999 appuser && useradd --system --uid 999 --gid appuser --create-home appuser
RUN mkdir -p /data && chown appuser:appuser /data
COPY package.json package-lock.json* ./
RUN npm install --omit=dev
COPY --from=build /app/dist ./dist
# From the build stage, not the build context: public/theme.css is generated by `npm run build` and
# gitignored, so copying public/ from a clean checkout would ship the pages without their styles.
COPY --from=build /app/public ./public
USER appuser
# /vault may be owned by the host's checkout user (debian), not appuser - git 2.35+ refuses to touch a
# repo it doesn't own (CVE-2022-24765 hardening) unless explicitly told it's safe. Baked into the
# image at build time (writes appuser's ~/.gitconfig) since the container's rootfs is read_only at
# runtime and couldn't take a `git config --global` call there.
RUN git config --global --add safe.directory /vault

EXPOSE 3000
CMD ["node", "dist/server.js"]
